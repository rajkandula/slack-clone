# MongoDB Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Authentication
# Run `openssl rand -base64 32` to generate a secure secret
JWT_SECRET="generate_a_secure_random_key_here"

# Media storage: any S3-compatible bucket (uploads, avatars, nightly backups)
# Note: If these are not provided, the application will automatically fall back to saving media files
# locally on the filesystem (under public/uploads/) for seamless zero-config local testing.
STORAGE_BUCKET="your-bucket-name"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_ENDPOINT="https://s3.your-provider.example"
STORAGE_PUBLIC_URL="https://media.your-domain.com"

# Harakumo — transactional email (OTP login codes, password resets, verification).
# Turn on Mail for your Harakumo project; add your own domain there to send from it.
# Create a key at Harakumo → Settings → API Keys. Server-side only.
HARAKUMO_API_KEY="hk_live_your_key_here"

# Public origin used to build password-reset links in emails.
# Falls back to the request host if unset (fine for local dev).
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Contact-form messages are emailed here (and always saved for the admin page).
CONTACT_EMAIL=""

# --- WebRTC calls (optional) ---
# STUN alone cannot connect peers behind symmetric NAT (most mobile carriers and
# corporate firewalls). Point these at a TURN server to relay those calls.
# Comma-separate the urls to offer both UDP and TLS/TCP.
NEXT_PUBLIC_TURN_URL="turn:turn.example.com:3478,turns:turn.example.com:5349"
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""

# --- Hosted TURN (optional) ---
# A TURN service's credential endpoint (POST { ttl } with a bearer token, answers
# { iceServers }). Server-side only: exchanged for short-lived browser credentials.
TURN_CREDENTIALS_URL=""
TURN_API_TOKEN=""

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
